# ── Core ─────────────────────────────────────────────────────
# Clave secreta de Django (generar una larga y aleatoria en producción)
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
# Hosts permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# ── Base de datos PostgreSQL ─────────────────────────────────
# En Railway: agregá un servicio Postgres y referencialo desde este servicio
# como  DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Sin la variable, con DEBUG=False el arranque falla a propósito.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brandmycpu
# Solo en true si conectás por la URL pública. La red interna de Railway no usa SSL.
DB_SSL=False

# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── DodoPayments ─────────────────────────────────────────────
DODO_API_KEY=
DODO_PRODUCT_ID=pdt_0NmNXr1VG164viZhNZCXL
# Secreto del webhook (formato whsec_<base64>). Es el que devuelve Dodo al
# crear el endpoint, NO la URL del endpoint. Suscribí estos eventos:
#   payment.succeeded, payment.failed, refund.succeeded, dispute.opened
DODO_WEBHOOK_SECRET=
# 'test' | 'live'
DODO_SERVER=test
# URL a la que Dodo redirige tras pagar (poseída por el frontend)
DODO_RETURN_URL=http://localhost:5173

# ── Modo demo ────────────────────────────────────────────────
# True = saltea Dodo y da el spot por pagado. Para grabar o probar el flujo.
# Sólo funciona con DEBUG=True: con DEBUG=False el arranque falla a propósito.
FAKE_PAYMENTS=False

# ── DataFast ─────────────────────────────────────────────────
# Payments API key (df_...). Vacía = no se reporta ningún pago.
DATAFAST_API_KEY=

# ── Goal / recaudación ───────────────────────────────────────
# En centavos de dólar. $800 = primera GPU dedicada.
SPOT_GOAL=80000